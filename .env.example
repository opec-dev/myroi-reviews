# Public application origin used in QR codes and embed snippets.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Added after creating the Convex project.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Added after creating the WorkOS AuthKit project.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3000/callback

# Master SMTP sender used for every client's notifications.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=myROIagency Reviews
SMTP_FROM_EMAIL=
# Development fallback only. Production reads the recipient and notification
# choices from each client's Convex settings.
FEEDBACK_NOTIFICATION_TO=
SMTP_NOTIFY_PRIVATE_FEEDBACK=true
SMTP_NOTIFY_NEW_REVIEWS=false

# Signed server-to-Convex ingestion for analytics and delivery history.
ANALYTICS_INGEST_SECRET=

# Failure monitoring should use an independent SMTP account/provider. If the
# primary SMTP is down, sending its own alert through that server cannot work.
SMTP_NOTIFY_FAILURES=true
SMTP_FAILURE_ALERT_TO=support-team@myroiagency.com
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM_EMAIL=

# Production requires a server-capable Next.js host (Vercel, Railway, or Azure App Service).
# The here.now deployment remains the public static design pilot.
