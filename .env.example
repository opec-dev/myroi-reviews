# Public application origin used in QR codes and embed snippets.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Added after creating the Convex project.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Added after creating the WorkOS AuthKit project.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3000/callback

# Production requires a server-capable Next.js host (Vercel, Railway, or Azure App Service).
# The here.now deployment remains the public static design pilot.
